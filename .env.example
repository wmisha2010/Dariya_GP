# ── База данных (Prisma + SQLite) ─────────────────────────────
# Относительный путь отсчитывается от папки prisma/ (schema.prisma),
# т.е. «file:../db/custom.db» = <корень проекта>/db/custom.db
DATABASE_URL="file:../db/custom.db"

# ── ИИ-провайдеры (необязательно, достаточно одного) ──────────
# Ключ OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Ключ Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Примечание: если заданы оба ключа, приоритет и логика фолбэка
# описаны в src/lib/openrouter.ts и src/lib/gemini.ts.
